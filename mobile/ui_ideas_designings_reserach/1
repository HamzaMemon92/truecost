### Shared component interfaces

Do not begin by implementing all visual detail. First stabilize component contracts:

```tsx
type ProviderLogoProps = {
  providerId: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  showName?: boolean;
  accessibilityLabel?: string;
};

export function ProviderLogo({
  providerId,
  size = 'md',
  showName = false,
  accessibilityLabel,
}: ProviderLogoProps) {
  const brand = providerBrandRegistry[providerId];

  if (!brand?.logoAsset) {
    return (
      <ProviderFallback
        name={brand?.displayName ?? providerId}
        size={size}
      />
    );
  }

  return (
    <View
      testID={`provider-logo-${providerId}`}
      accessibilityLabel={
        accessibilityLabel ?? `${brand.displayName} provider`
      }
    >
      <Image
        source={brand.logoAsset}
        contentFit="contain"
        transition={120}
      />
      {showName ? <Text>{brand.displayName}</Text> : null}
    </View>
  );
}
```

