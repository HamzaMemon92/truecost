OPENAI_API_KEY=
SHOPPING_MODEL=gpt-4o-mini
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
SHOPPING_BACKEND_ORIGIN=http://localhost:8001
APP_ENV=development
DATABASE_URL=postgresql+psycopg://truecost:change-me@localhost:5432/truecost
REDIS_URL=redis://localhost:6379/0
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
TRUSTED_HOSTS=*
# Generate a unique secret for every non-development environment. Never commit the real value.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_10_MINUTES=5

# Development only. The OTP is printed only in the visible backend console.
SMS_PROVIDER=console
SMS_FALLBACK_PROVIDER=none
SMS_REQUEST_TIMEOUT_SECONDS=10

# Recommended India production route. Complete DLT/entity/template approval first,
# then set SMS_PROVIDER=msg91 and optionally SMS_FALLBACK_PROVIDER=twofactor.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Optional India failover route. Use the exact approved 2Factor template name.
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=

# Optional primary/fallback route for countries supported by your Twilio sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional enhanced-security token for the Expo Push Service.
EXPO_ACCESS_TOKEN=
PRICE_WATCH_SCHEDULER_ENABLED=true
PRICE_WATCH_INTERVAL_SECONDS=300
TASK_EXECUTION_MODE=inline
PROVIDER_PREVIEW_ENABLED=false

# Optional official OAuth broker. Never point this at a provider login page or store browser cookies.
PROVIDER_CONNECTION_BROKER_URL=
PROVIDER_CONNECTION_BROKER_SECRET=
PROVIDER_CONNECTION_ATTEMPT_MINUTES=10
# Observability and operational access. Never include personal data in tags/logs.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ADMIN_EMAILS=

# Broker container (official provider OAuth only). Generate Fernet keys with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_DATABASE_URL=postgresql+psycopg://truecost_broker:change-me@localhost:5432/truecost
BROKER_REDIS_URL=redis://localhost:6379/1
BROKER_PUBLIC_URL=http://localhost:8010
BROKER_CALLBACK_SECRET=
BROKER_VAULT_ENCRYPTION_KEYS=
BROKER_ENABLED_PROVIDERS=
BROKER_ALLOWED_MOBILE_REDIRECTS=truecost://provider-connect

# For Python 3.11+ deep-agent support, upgrade Python and reinstall dependencies:
# python -m venv --upgrade-deps --clear .venv
# .venv\Scripts\activate
# pip install -e ".[dev]"
